SET SERVEROUTPUT ON;

DECLARE
    TYPE t_text_list IS TABLE OF VARCHAR2(500 CHAR);
    TYPE t_number_list IS TABLE OF NUMBER;

    v_expected_names t_text_list := t_text_list(
        '나만의 향기, 캔들 만들기',
        '처음 시작하는 유화 클래스',
        '홈베이킹으로 만드는 달콤한 하루',
        '계절을 담은 플라워 리스 만들기',
        '몸과 마음이 가벼워지는 요가',
        '처음 배우는 어쿠스틱 기타',
        '손끝으로 빚는 나만의 도자기',
        '취향을 담은 나만의 향수',
        '가죽으로 만드는 카드지갑',
        '라떼아트와 홈카페 한 잔',
        '오늘을 위한 꽃다발 만들기',
        '은반지 원데이 주얼리 클래스',
        '처음 도전하는 실내 클라이밍',
        '감성 피크닉 사진 산책',
        '스마트폰 제품 사진 촬영법',
        '포근한 마크라메 월행잉',
        '여행 풍경 수채화 그리기',
        '집밥이 맛있어지는 한식 클래스',
        '천천히 만드는 사워도우 브레드',
        '리듬을 즐기는 댄스 입문'
    );

    -- 클래스별 후기의 핵심 내용
    v_points t_text_list := t_text_list(
        '향을 직접 고르고 색을 조합해 캔들을 만드는 과정이',
        '색을 섞고 캔버스에 풍경을 채워가는 과정이',
        '반죽부터 머핀을 굽고 포장하는 과정이',
        '계절 꽃을 골라 리스 모양을 잡는 과정이',
        '호흡에 맞춰 기본 요가 자세를 익히는 시간이',
        '기본 코드를 배우고 짧은 곡을 연주하는 과정이',
        '흙을 빚어 원하는 형태의 그릇을 만드는 과정이',
        '여러 향료를 비교하고 취향에 맞게 조합하는 과정이',
        '가죽에 직접 바느질하고 지갑을 완성하는 과정이',
        '우유 스티밍과 하트 라떼아트를 연습하는 시간이',
        '꽃의 색과 높낮이를 맞춰 꽃다발을 만드는 과정이',
        '반지 표면을 다듬고 광택을 내는 과정이',
        '기본 동작을 익히고 쉬운 코스에 도전하는 시간이',
        '자연광과 소품을 활용해 사진을 찍는 시간이',
        '조명과 구도에 따라 사진이 달라지는 것을 배우는 과정이',
        '기본 매듭을 반복해 월행잉을 완성하는 과정이',
        '물의 양을 조절하며 풍경을 채색하는 과정이',
        '재료 손질과 양념 비율을 배우는 과정이',
        '발효 원리를 배우고 반죽을 접고 성형하는 과정이',
        '기본 스텝을 익히고 음악에 맞춰 움직이는 시간이'
    );

    v_endings t_text_list := t_text_list(
        ' 정말 재미있었어요. 처음이라 걱정했는데 설명이 차근차근 이어져서 끝까지 잘 따라갈 수 있었습니다.',
        ' 만족스러웠습니다. 막히는 부분을 바로 알려주셔서 도움이 됐고, 배운 내용을 다시 연습해보고 싶어요.',
        ' 생각보다 어려웠지만 새로운 취미를 경험할 수 있어 좋았습니다. 마지막에 연습할 시간이 조금 더 있었으면 좋겠어요.',
        ' 좋았어요. 수업 분위기가 편안해서 혼자 참여해도 부담이 없었고, 질문에도 친절하게 답해주셨습니다.',
        ' 인상적이었어요. 직접 해보니 더 잘 이해됐습니다. 다음에는 다른 내용의 클래스도 들어보고 싶어요.'
    );

    v_ratings t_number_list := t_number_list(5, 4, 3, 5, 4);

    v_sch_no SCHEDULE.sch_no%TYPE;
    v_rsv_no RESERVATION.rsv_no%TYPE;
    v_mem_no MEMBER.mem_no%TYPE;
    v_price ONEDAY.cls_price%TYPE;
    v_name ONEDAY.cls_name%TYPE;
    v_content REVIEW.rev_content%TYPE;

    v_count NUMBER;
    v_rating_index NUMBER;
    v_added NUMBER := 0;

    -- 실행 시점을 기준으로 날짜를 계산
    v_now TIMESTAMP := LOCALTIMESTAMP;
    v_completed_at TIMESTAMP;
    v_review_at TIMESTAMP;

BEGIN
    SAVEPOINT before_review_data;

    -- 1. 일반 회원 20명 확인
    SELECT COUNT(*)
    INTO v_count
    FROM MEMBER
    WHERE mem_no BETWEEN 2 AND 21
      AND mem_role = 'USER';

    IF v_count <> 20 THEN
        RAISE_APPLICATION_ERROR(
            -20001,
            '회원 번호 2~21번의 일반 회원 20명을 확인해주세요.'
        );
    END IF;

    -- 2. 클래스 번호와 이름 확인
    FOR i IN 1..20 LOOP
        SELECT cls_name
        INTO v_name
        FROM ONEDAY
        WHERE cls_no = i;

        IF v_name <> v_expected_names(i) THEN
            RAISE_APPLICATION_ERROR(
                -20002,
                '클래스 번호와 이름이 다릅니다: ' || i
            );
        END IF;
    END LOOP;

    -- 3. 같은 내용의 후기 데이터가 이미 있으면 재등록 중단
    FOR i IN 1..20 LOOP
        FOR j IN 1..5 LOOP
            v_content := v_points(i) || v_endings(j);

            SELECT COUNT(*)
            INTO v_count
            FROM REVIEW
            WHERE cls_no = i
              AND rev_content = v_content;

            IF v_count > 0 THEN
                RAISE_APPLICATION_ERROR(
                    -20003,
                    '이미 후기 데이터가 등록되어 있습니다. 클래스: '
                    || v_expected_names(i)
                );
            END IF;
        END LOOP;
    END LOOP;

    -- 4. 클래스별 과거 일정과 완료 예약·후기 생성
    FOR i IN 1..20 LOOP
        SELECT cls_price
        INTO v_price
        FROM ONEDAY
        WHERE cls_no = i;

        -- 클래스별로 1~5일 전 수업으로 설정
        v_completed_at :=
            v_now - NUMTODSINTERVAL(MOD(i - 1, 5) + 1, 'DAY');

        -- 후기용 일정: 정원 5명
        INSERT INTO SCHEDULE (
            cls_no,
            sch_start_date,
            sch_capacity,
            sch_created_at,
            sch_updated_at
        ) VALUES (
            i,
            TRUNC(CAST(v_completed_at AS DATE)),
            5,
            v_completed_at - INTERVAL '10' DAY,
            v_completed_at - INTERVAL '10' DAY
        )
        RETURNING sch_no INTO v_sch_no;

        FOR j IN 1..5 LOOP
            -- 클래스마다 작성자를 순환 배정
            v_mem_no := MOD((i - 1) * 3 + j - 1, 20) + 2;

            -- 수강 완료 후 1~5시간 뒤 후기 작성
            v_review_at :=
                v_completed_at + NUMTODSINTERVAL(j, 'HOUR');

            -- 평점 배치를 클래스마다 변경
            v_rating_index := MOD(i + j - 2, 5) + 1;

            v_content := v_points(i) || v_endings(j);

            INSERT INTO RESERVATION (
                mem_no,
                sch_no,
                rsv_count,
                rsv_amount,
                rsv_status,
                rsv_created_at,
                rsv_confirmed_at,
                rsv_completed_at
            ) VALUES (
                v_mem_no,
                v_sch_no,
                1,
                v_price,
                'COMPLETED',
                v_completed_at - INTERVAL '7' DAY,
                v_completed_at - INTERVAL '6' DAY,
                v_completed_at
            )
            RETURNING rsv_no INTO v_rsv_no;

            INSERT INTO REVIEW (
                rsv_no,
                cls_no,
                rev_rating,
                rev_content,
                rev_created_at,
                rev_status
            ) VALUES (
                v_rsv_no,
                i,
                v_ratings(v_rating_index),
                v_content,
                v_review_at,
                'N'
            );

            v_added := v_added + 1;
        END LOOP;
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('추가된 후기용 일정: 20건');
    DBMS_OUTPUT.PUT_LINE('추가된 완료 예약: ' || v_added || '건');
    DBMS_OUTPUT.PUT_LINE('추가된 후기: ' || v_added || '건');

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK TO before_review_data;
        RAISE;
END;
/

SELECT
    o.cls_no,
    o.cls_name,
    COUNT(rv.rev_no) AS review_count,
    ROUND(AVG(rv.rev_rating), 1) AS average_rating
FROM ONEDAY o
LEFT JOIN REVIEW rv
    ON rv.cls_no = o.cls_no
   AND rv.rev_status = 'N'
WHERE o.cls_no BETWEEN 1 AND 20
GROUP BY o.cls_no, o.cls_name
ORDER BY o.cls_no;